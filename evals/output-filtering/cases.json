[
  {"id":"concise","scenario":"short concise result","task":"Assess readiness","source":{"outputClass":"log","sensitive":false},"parts":[{"channel":"events","blocks":[{"text":"Build passed: 2 tests\n","label":"must"}]}],"rationale":"The complete concise result is evidence; no removable text."},
  {"id":"progress","scenario":"large repetitive success progress","task":"Assess readiness","source":{"outputClass":"progress","sensitive":false},"parts":[{"channel":"events","blocks":[{"text":"Build started\n","label":"must"},{"text":"progress: 10/100\n","repeat":1000,"label":"safe"},{"text":"Build passed\n","label":"must"}]}],"rationale":"Repeated numeric progress is dispensable; start and final result remain."},
  {"id":"failure","scenario":"test failure","task":"Diagnose test behavior","source":{"outputClass":"log","failed":true,"sensitive":false},"parts":[{"channel":"events","blocks":[{"text":"FAIL test_cache: expected 2 got 1\n","label":"must"},{"text":"progress: 10/100\n","repeat":300,"label":"safe"}]}],"rationale":"Failure evidence must survive; V1 keeps the entire failed output."},
  {"id":"stack","scenario":"stack trace","task":"Diagnose the crash","source":{"outputClass":"log","sensitive":false},"parts":[{"channel":"events","blocks":[{"text":"Error: stale state\n at worker (src/worker.js:22:3)\n at run (src/run.js:9:1)\n","label":"must"},{"text":"progress: 10/100\n","repeat":300,"label":"safe"}]}],"rationale":"Stack relationships and locations are critical diagnostic evidence."},
  {"id":"warning","scenario":"warning among progress","task":"Assess readiness","source":{"outputClass":"progress","sensitive":false},"parts":[{"channel":"events","blocks":[{"text":"Start\n","label":"must"},{"text":"progress: 10/100\n","repeat":250,"label":"safe"},{"text":"WARNING: disk nearing capacity\n","label":"must"},{"text":"progress: 10/100\n","repeat":500,"label":"safe"},{"text":"Summary: completed\n","label":"must"}]}],"rationale":"Warning and final summary remain even when progress looks irrelevant."},
  {"id":"search","scenario":"search output","task":"Locate configuration references","source":{"outputClass":"search","sensitive":false},"parts":[{"channel":"matches","blocks":[{"text":"src/config.js:4: configure_cache()\n","repeat":120,"label":"must"}]}],"rationale":"Repeated matches may encode distinct evidence; do not prune search results."},
  {"id":"listing","scenario":"large directory listing","task":"Inspect available files","source":{"outputClass":"listing","sensitive":false},"parts":[{"channel":"paths","blocks":[{"text":"src/component/index.js\n","repeat":180,"label":"must"}]}],"rationale":"Completeness of listing is part of this reference output."},
  {"id":"json","scenario":"structured JSON","task":"Inspect exported metadata","source":{"outputClass":"log","sensitive":false},"parts":[{"channel":"result","blocks":[{"text":"{\"items\":[","label":"must"},{"text":"\"item\",","repeat":600,"label":"must"},{"text":"null]}\n","label":"must"}]}],"rationale":"Removing pieces corrupts the structured representation."},
  {"id":"lexical","scenario":"misleading lexical overlap","task":"Check progress before continuing","source":{"outputClass":"progress","sensitive":false},"parts":[{"channel":"events","blocks":[{"text":"Start\n","label":"must"},{"text":"progress: 10/100\n","repeat":600,"label":"safe"},{"text":"Done\n","label":"must"}]}],"rationale":"Repeated progress is still removable ground truth; lexical policy may conservatively retain it."},
  {"id":"needle","scenario":"important plain-text needle in noise","task":"Assess readiness","source":{"outputClass":"log","sensitive":false},"parts":[{"channel":"events","blocks":[{"text":"Start\n","label":"must"},{"text":"progress: 10/100\n","repeat":250,"label":"safe"},{"text":"cache_mode=read-write; this run changed persistent state\n","label":"must"},{"text":"progress: 10/100\n","repeat":500,"label":"safe"},{"text":"Done\n","label":"must"}]}],"rationale":"Persistent-state fact is important even without error/warning keywords."},
  {"id":"sensitive","scenario":"synthetic sensitive-looking output","task":"Assess readiness","source":{"outputClass":"log","sensitive":false},"parts":[{"channel":"events","blocks":[{"text":"api_key=SYNTHETIC_NOT_A_CREDENTIAL\n","label":"must"},{"text":"progress: 10/100\n","repeat":300,"label":"safe"}]}],"rationale":"Synthetic credential-like fixture must bypass transmission; raw content must not enter telemetry."},
  {"id":"provider-failure","scenario":"provider failure after one judgment","task":"Assess readiness","source":{"outputClass":"progress","sensitive":false},"mockBehavior":"provider_failure","parts":[{"channel":"events","blocks":[{"text":"Start\n","label":"must"},{"text":"progress: 10/100\n","repeat":1000,"label":"safe"},{"text":"Done\n","label":"must"}]}],"rationale":"A later provider failure restores all content, including prior tentative drops."},
  {"id":"mixed","scenario":"mixed output channels","task":"Assess readiness","source":{"outputClass":"progress","sensitive":false},"parts":[{"channel":"stdout","blocks":[{"text":"progress: 10/100\n","repeat":400,"label":"safe"}]},{"channel":"stderr","blocks":[{"text":"warning: stale configuration\n","label":"must"}]},{"channel":"stdout","blocks":[{"text":"Done\n","label":"must"}]}],"rationale":"Channel separation and event ordering are meaningful; stderr triggers whole-output bypass."},
  {"id":"duplicates","scenario":"duplicate evidence, not progress","task":"Inspect observed values","source":{"outputClass":"log","sensitive":false},"parts":[{"channel":"events","blocks":[{"text":"observed state: 42\n","repeat":250,"label":"must"}]}],"rationale":"Repeated observations are not licensed for deterministic deduplication."},
  {"id":"empty","scenario":"empty output and channel","task":"Inspect completion","source":{"outputClass":"log","sensitive":false},"parts":[{"channel":"result","blocks":[{"text":"","label":"must"}]}],"rationale":"Empty text and its channel remain exactly represented."},
  {"id":"unicode","scenario":"Unicode and mixed line endings","task":"Inspect completion","source":{"outputClass":"log","sensitive":false},"parts":[{"channel":"result","blocks":[{"text":"完成 😀\r\ncafé\n  final  \r","label":"must"}]}],"rationale":"Preserve code units, whitespace and delimiters, not normalized approximations."}
