import fs from 'node:fs';import path from 'node:path';import assert from 'node:assert/strict';import {pathToFileURL} from 'node:url';
const product=path.resolve(process.argv[2]),load=(name:string)=>import(pathToFileURL(path.join(product,'src',name)).href+'?acceptance='+Date.now());
const rows:{name:string,pass:boolean,error:string|null}[]=[];const check=async(name:string,fn:()=>unknown|Promise<unknown>)=>{try{await fn();rows.push({name,pass:true,error:null})}catch(error:any){rows.push({name,pass:false,error:String(error?.message??error).slice(0,500)})}};
const d:any=await load('domain.ts'),s:any=await load('storage.ts'),io:any=await load('io.ts');
const at=(iso:string)=>new Date(iso),input={title:'Database unavailable',description:'Primary datastore is rejecting writes',severity:'P0'};
const incident=()=>d.createIncident(input,at('2026-01-01T00:00:00.000Z'),()=> 'inc-stable');
await check('incident creation',()=>{const x=incident();assert.deepEqual(x,{id:'inc-stable',...input,status:'OPEN',createdAt:'2026-01-01T00:00:00.000Z',updatedAt:'2026-01-01T00:00:00.000Z'})});
await check('incident editing',()=>{const x=d.editIncident(incident(),{title:'Updated'},at('2026-01-01T00:10:00.000Z'));assert.equal(x.title,'Updated');assert.equal(x.id,'inc-stable');assert.equal(x.createdAt,incident().createdAt);assert.equal(incident().title,input.title)});
await check('incident deletion',()=>assert.deepEqual(d.deleteIncident([incident()],'inc-stable'),[]));
await check('resolve transition',()=>assert.equal(d.transitionIncident(incident(),'RESOLVED',at('2026-01-01T01:00:00Z')).status,'RESOLVED'));
await check('reopen transition',()=>{const x=d.transitionIncident(d.transitionIncident(incident(),'RESOLVED',at('2026-01-01T01:00:00Z')),'OPEN',at('2026-01-01T02:00:00Z'));assert.equal(x.status,'OPEN')});
await check('investigating transition',()=>assert.equal(d.transitionIncident(incident(),'INVESTIGATING').status,'INVESTIGATING'));
await check('stable IDs',()=>{const x=incident();assert.equal(d.editIncident(x,{description:'x'}).id,x.id);assert.equal(d.transitionIncident(x,'RESOLVED').id,x.id)});
await check('severity handling',()=>{for(const severity of ['P0','P1','P2','P3'])assert.equal(d.createIncident({...input,severity},new Date(),()=>severity).severity,severity);assert.deepEqual(Object.keys(d.SLA_HOURS).sort(),['P0','P1','P2','P3'])});
for(const [severity,hours] of Object.entries({P0:1,P1:4,P2:24,P3:72}))await check(`${severity} SLA boundary`,()=>{const x=d.createIncident({...input,severity},at('2026-01-01T00:00:00Z'),()=>severity);assert.equal(d.slaState(x,at(`2026-01-${hours===72?'04':hours===24?'02':'01'}T${hours<24?String(hours).padStart(2,'0'):'00'}:00:00Z`)),'WITHIN_SLA');assert.equal(d.slaState(x,new Date(Date.parse(x.createdAt)+hours*3600000+1)),'OVERDUE')});
await check('resolved incidents not actively overdue',()=>{const x=d.transitionIncident(incident(),'RESOLVED',at('2026-01-02T00:00:00Z'));assert.equal(d.slaState(x,at('2026-02-01T00:00:00Z')),'RESOLVED')});
await check('persisted timestamps drive SLA',()=>{const raw=s.encodeStorage([incident()]),[x]=s.decodeStorage(raw);assert.equal(x.createdAt,incident().createdAt);assert.equal(d.slaState(x,at('2026-01-01T01:00:00Z')),'WITHIN_SLA')});
await check('versioned persistence',()=>{assert.equal(s.STORAGE_VERSION,1);assert.equal(JSON.parse(s.encodeStorage([incident()])).version,1)});
await check('corrupted storage safety',()=>{assert.deepEqual(s.decodeStorage('{broken'),[]);assert.deepEqual(s.decodeStorage(JSON.stringify({version:999,incidents:[]})),[])});
await check('versioned export JSON',()=>{const x=JSON.parse(io.exportIncidents([incident()],at('2026-01-03T00:00:00Z')));assert.equal(x.version,1);assert.equal(x.incidents.length,1)});
await check('export import round trip',()=>assert.deepEqual(io.importIncidents(io.exportIncidents([incident()]),[]),[incident()]));
await check('repeated import deduplicates stable IDs',()=>{const text=io.exportIncidents([incident()]);const once=io.importIncidents(text,[]),twice=io.importIncidents(text,once);assert.equal(twice.filter((x:any)=>x.id==='inc-stable').length,1)});
await check('invalid import preserves existing state',()=>{const existing=[incident()],before=JSON.stringify(existing);assert.throws(()=>io.importIncidents('{bad',existing));assert.equal(JSON.stringify(existing),before)});
await check('domain logic independent of UI',()=>{for(const name of ['domain.ts','storage.ts','io.ts'])assert.doesNotMatch(fs.readFileSync(path.join(product,'src',name),'utf8'),/from\s+['"]react|react-dom/i)});
console.log(JSON.stringify({schemaVersion:'opsdesk.acceptance.v1',checks:rows,passed:rows.filter(x=>x.pass).length,total:rows.length}));process.exitCode=rows.every(x=>x.pass)?0:1;
