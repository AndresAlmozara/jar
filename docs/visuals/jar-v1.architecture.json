  "cards": [
    {
      "dot": "rose",
      "title": "Authority split",
      "items": [
        "DETERMINISTIC AUTHORITY surrounds bounded semantic judgment.",
        "JEV proposes bounded need/relevance judgments; it never decides permissions, inventory truth, execution, policy, or verification.",
        "The host and its permission system remain authoritative for tool execution."
      ]
    },
    {
      "dot": "cyan",
      "title": "Canonical V1 profile",
      "items": [
        "JAR invokes M5 and M6; their verified guidance and repository evidence contribute to the routed context.",
        "M5: ECC-native deterministic skill routing.",
        "M6: deterministic bounded repository retrieval with provenance.",
        "M7: exact-pass-through Shadow observation; no causal pruning.",
        "M8: hierarchical cover contract; causal only for complete, identity-bound inventories."
      ]
    },
    {
      "dot": "amber",
      "title": "Unknown stays unknown",
      "items": [
        "Incomplete inventories are observational and never become an implicit deny.",
        "Provider failure cannot widen the independently policy-eligible set.",
        "Configuration, proposal, materialization, execution, and verification remain distinct evidence."
      ]
    },
    {
      "dot": "emerald",
      "title": "Passive observability",
      "items": [
        "Adapters emit allowlisted metadata and correlation IDs to a local atomic spool.",
        "Maintenance deduplicates, checksum-verifies, aggregates, and reports deterministically.",
        "Telemetry failures are non-authoritative and do not change an otherwise valid route."
      ]
    }
  ]
