{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jar.local/schemas/always-on-telemetry-event.schema.json",
  "title": "JAR always-on metadata telemetry event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "event_name",
    "severity",
    "observed_at_utc",
    "installation_id",
    "config_hash",
    "adapter_id",
    "data_origin",
    "correlation_status",
    "source_kind",
    "coverage",
    "truncation",
    "payload"
  ],
  "properties": {
    "schema_version": {"const": "jar.telemetry.event.v1"},
    "event_id": {"type": "string", "minLength": 1},
    "event_name": {"enum": ["session.observed", "hook.finished", "routing.observed", "tool.started", "tool.finished", "usage.observed", "feedback.recorded", "telemetry.health"]},
    "severity": {"enum": ["debug", "info", "warn", "error"]},
    "occurred_at_utc": {"type": ["string", "null"], "format": "date-time"},
    "observed_at_utc": {"type": "string", "format": "date-time"},
    "installation_id": {"type": "string", "minLength": 1},
    "runtime_id": {"type": ["string", "null"]},
    "jar_source_commit": {"type": ["string", "null"]},
    "config_hash": {"type": "string", "minLength": 1},
    "adapter_id": {"type": "string", "minLength": 1},
    "adapter_version": {"type": "string"},
    "host_runtime_version": {"type": ["string", "null"]},
    "study_id": {"type": ["string", "null"]},
    "data_origin": {"enum": ["production", "validation", "benchmark", "historical_import"]},
    "session_id": {"type": ["string", "null"]},
    "native_thread_id": {"type": ["string", "null"]},
    "actor_id": {"type": ["string", "null"]},
    "turn_id": {"type": ["string", "null"]},
    "route_id": {"type": ["string", "null"]},
    "tool_invocation_id": {"type": ["string", "null"]},
    "repository_id": {"type": ["string", "null"]},
    "correlation_status": {"enum": ["exact", "partial", "unlinked"]},
    "correlation_missing_reason": {"type": ["string", "null"]},
    "source_kind": {"type": "string"},
    "parser_version": {"type": ["string", "null"]},
    "coverage": {"type": "object"},
    "truncation": {"type": "object"},
    "payload": {"type": "object"}
  }
}
