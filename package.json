{
  "name": "jev-agentic-router",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Portable System-1 routing layer for coding agents, with deterministic control, bounded semantic judgment, and local observability.",
  "bin": {"jar": "./bin/jar.js"},
  "scripts": {
    "test": "node --test tests/core.test.js tests/strategy.test.js tests/telemetry.test.js tests/jev-provider.test.js tests/capability-foundation.test.js tests/capability-strategies.test.js tests/skill-routing-foundation.test.js tests/skill-routing-jev-strategies.test.js tests/skill-routing-ecc-hybrids.test.js tests/output-foundation.test.js tests/output-recovery.test.js tests/output-sieve.test.js tests/opencode-observer.test.js tests/v2-setup.test.js",
    "test:diagnostics": "node --test evals/component-diagnostics/component-diagnostics.test.mjs evals/component-diagnostics/m8-v2/m8-v2.test.mjs",
    "check": "node --check bin/jar.js && npm test",
    "eval:smoke": "node evals/smoke-test/run.mjs",
    "eval:smoke:preflight": "node evals/smoke-test/run.mjs --preflight-only",
    "eval:benchmark:identity": "node evals/benchmark/run.mjs --identity",
    "eval:benchmark:preflight": "node evals/benchmark/run.mjs --preflight-only",
    "eval:components:list": "node evals/component-diagnostics/cli.mjs list",
    "eval:components:identity": "node evals/component-diagnostics/cli.mjs identity",
    "eval:components:preflight": "node evals/component-diagnostics/cli.mjs preflight",
    "eval:components:test": "node --test evals/component-diagnostics/component-diagnostics.test.mjs",
    "eval:m8-v2:test": "node --test evals/component-diagnostics/m8-v2/m8-v2.test.mjs",
    "eval:m8-v2:identity": "node evals/component-diagnostics/m8-v2/cli.mjs identity",
    "eval:m8-v2:preflight": "node evals/component-diagnostics/m8-v2/cli.mjs preflight",
    "runtime:discover": "node scripts/codex-runtime-store.mjs discover",
    "runtime:status": "node scripts/codex-runtime-store.mjs status",
    "catalog:fixture": "node bin/jar.js catalog inspect --ecc-root fixtures/ecc-mini",
    "demo:trace": "node bin/jar.js demo trace",
    "codex:plugin:install": "node scripts/codex-plugin-manager.mjs install",
    "codex:plugin:update": "node scripts/codex-plugin-manager.mjs update",
    "codex:plugin:status": "node scripts/codex-plugin-manager.mjs status",
    "codex:plugin:doctor": "node scripts/codex-plugin-manager.mjs doctor",
    "codex:plugin:uninstall": "node scripts/codex-plugin-manager.mjs uninstall",
    "telemetry:benchmark": "node scripts/benchmark-telemetry-recorder.mjs"
  },
  "engines": {"node": ">=20"},
  "license": "MIT"
}
